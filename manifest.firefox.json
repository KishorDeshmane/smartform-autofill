{
  "manifest_version": 3,
  "name": "SmartForm AutoFill",
  "version": "2.2.0",
  "description": "Local QA form filler with dynamic dependent dropdown handling, reusable test data, file mappings, QA scenarios, and screenshot reports.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "utils/ext.js",
      "utils/idb-storage.js",
      "utils/storage.js",
      "background/service-worker.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SmartForm AutoFill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smartform-autofill@local.smartform",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open SmartForm AutoFill"
    }
  }
}
