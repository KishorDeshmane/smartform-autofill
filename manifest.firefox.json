{
  "manifest_version": 3,
  "name": "QA Kits",
  "version": "2.2.0",
  "description": "QA toolkit for testers: fill forms with fake test data, test wrong and edge values, upload files, scan pages, create test cases.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "utils/ext.js",
      "utils/idb-storage.js",
      "utils/storage.js",
      "background/service-worker.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QA Kits",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "qa-kits@local.qakits",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open QA Kits"
    }
  }
}
