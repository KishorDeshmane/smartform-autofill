{
  "name": "qa-kits",
  "version": "2.2.0",
  "private": true,
  "description": "Local QA form-filling browser extension",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "build:chrome": "node scripts/build-extension.mjs chrome",
    "build:firefox": "node scripts/build-extension.mjs firefox",
    "verify:popup": "node scripts/verify-popup-ui.mjs",
    "verify:glass": "node scripts/verify-glass-popup.mjs",
    "test:e2e": "npm run build:chrome && node --test --test-concurrency=1 --test-timeout=180000 \"tests-e2e/*.mjs\"",
    "verify:responsive": "node scripts/verify-responsive.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
